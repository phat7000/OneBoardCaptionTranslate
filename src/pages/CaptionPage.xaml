<Page
    x:Class="LiveCaptionsTranslator.CaptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Capture"
    JournalEntry.KeepAlive="True"
    mc:Ignorable="d">

    <Grid Margin="5,5,15,5">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="OriginalCaption_Row" Height="*" MinHeight="43" />
            <RowDefinition x:Name="TranslatedCaption_Row" Height="*" MinHeight="43" />
            <RowDefinition x:Name="CaptionLogCard_Row" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="TranscriptLineStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,1,0,1" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFinal}" Value="False">
                        <Setter Property="Opacity" Value="0.82" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <ui:Card
            Grid.Row="0"
            Margin="0,0,0,2"
            Padding="8"
            PreviewMouseWheel="OriginalCard_PreviewMouseWheel">
            <ScrollViewer
                x:Name="OriginalScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                ScrollChanged="OriginalScrollViewer_ScrollChanged"
                VerticalContentAlignment="Bottom"
                VerticalScrollBarVisibility="Hidden">
                <ItemsControl
                    x:Name="OriginalTranscriptItems"
                    VerticalAlignment="Bottom"
                    ItemsSource="{Binding OriginalTranscriptLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Cursor="Hand"
                                MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                Style="{StaticResource TranscriptLineStyle}"
                                Text="{Binding Text}"
                                ToolTip="Click to copy; Ctrl+wheel changes font size" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ui:Card>

        <ui:Card
            Grid.Row="1"
            Margin="0,2,0,0"
            Padding="8"
            PreviewMouseWheel="TranslatedCard_PreviewMouseWheel">
            <ScrollViewer
                x:Name="TranslatedScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                ScrollChanged="TranslatedScrollViewer_ScrollChanged"
                VerticalContentAlignment="Bottom"
                VerticalScrollBarVisibility="Hidden">
                <ItemsControl
                    x:Name="TranslatedTranscriptItems"
                    VerticalAlignment="Bottom"
                    ItemsSource="{Binding TranslatedTranscriptLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Cursor="Hand"
                                MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                Style="{StaticResource TranscriptLineStyle}"
                                Text="{Binding Text}"
                                ToolTip="Click to copy; Ctrl+wheel changes font size" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ui:Card>

        <ui:Card
            x:Name="LogCards"
            Grid.Row="2"
            MaxHeight="160"
            Margin="0,4,0,5"
            Padding="8"
            Background="Transparent"
            BorderBrush="#00000000">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DisplayLogCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,5" Padding="8,4" BorderBrush="#20000000" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock FontSize="12" Text="{Binding SourceText}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0" FontSize="14" Text="{Binding TranslatedText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ui:Card>
    </Grid>
</Page>
